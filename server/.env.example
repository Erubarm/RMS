# Railway автоматически подставляет DATABASE_URL при подключении PostgreSQL плагина
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Секреты — придумай сам, минимум 32 символа
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min
ADMIN_SECRET=your_admin_panel_password

# VK Mini App (из настроек приложения на vk.com/dev)
VK_APP_ID=your_vk_app_id
VK_SECURE_KEY=your_vk_secure_key
VK_GROUP_TOKEN=your_vk_group_token

NODE_ENV=production
# PORT выставляет Railway автоматически, не указывай вручную
